# Copy to .env and adjust.

# Interface and port the server listens on. 0.0.0.0 = reachable from the LAN.
HOST=0.0.0.0
PORT=3000

# Shared secret for the API, WebSocket and web UI (min 8 chars).
STAGEHAND_TOKEN=change-me-please

# SQLite file, relative to apps/server.
DATABASE_PATH=data/stagehand.db

# Serial port of the DMX interface. Leave empty to use the first FTDI adapter
# found, e.g. /dev/serial/by-id/usb-FTDI_FT232R_USB_UART_<serial>-if00-port0
DMX_PORT=
